{
  "name": "Wilcoxon Test",
  "description": "Tests for differences between paired distributions of data points.",
  "tags": [
    "statistical testing"
  ],
  "authors": [
    "tercen"
  ],
  "urls": [
    "https://github.com/tercen/wilcoxtest_operator"
  ],
  "properties": [
    {
      "kind": "EnumeratedProperty",
      "name": "alternative",
      "defaultValue": "two.sided",
      "values": [
        "two.sided",
        "less",
        "greater"
      ],
      "description": "A character string specifying the alternative hypothesis."
    },
    {
      "kind": "BooleanProperty",
      "name": "paired",
      "defaultValue": false,
      "description": "A logical variable indicating whether the observations are paired. If true, a label is expected from the Tercen projection to assign the pairs."
    },
    {
      "kind": "DoubleProperty",
      "name": "mu",
      "defaultValue": 0,
      "description": "A number indicating the true value of the mean (or difference in means if you are performing a two sample test)"
    },
    {
      "kind": "BooleanProperty",
      "name": "conf.int",
      "defaultValue": true,
      "description": "Compute confidence intervals"
    },
    {
      "kind": "DoubleProperty",
      "name": "conf.level",
      "defaultValue": 0.95,
      "description": "Confidence level of the interval."
    }
  ],
  "operatorSpec": {
    "kind": "OperatorSpec",
    "ontologyUri": "https://tercen.com/_ontology/tercen",
    "ontologyVersion": "0.0.1",
    "inputSpecs": [
      {
        "kind": "CrosstabSpec",
        "metaFactors": [
          {
            "kind": "MetaFactor",
            "name": "Groups",
            "type": "",
            "description": "Represents the groups to compare.",
            "ontologyMapping": "group",
            "crosstabMapping": "color",
            "cardinality": "1..n",
            "factors": []
          },
          {
            "kind": "MetaFactor",
            "name": "Pairing Labels",
            "type": "",
            "description": "Represents the pairing of observations.",
            "ontologyMapping": "label",
            "crosstabMapping": "label",
            "cardinality": "1..n",
            "factors": []
          }
        ],
        "axis": [
          {
            "kind": "AxisSpec",
            "metaFactors": [
              {
                "kind": "MetaFactor",
                "name": "Measurement",
                "type": "numeric",
                "description": "Measurement values for the test.",
                "ontologyMapping": "measurement",
                "crosstabMapping": "y",
                "cardinality": "1",
                "factors": []
              }
            ]
          }
        ]
      }
    ]
  }
}